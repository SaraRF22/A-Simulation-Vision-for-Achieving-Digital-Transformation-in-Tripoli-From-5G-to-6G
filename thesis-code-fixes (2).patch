+function L_dB = o2i_loss_tripoli(f_GHz, Config)
+% O2I_LOSS_TRIPOLI  Outdoor-to-indoor wall loss for Tripoli masonry at any carrier.
+% Interpolates (in log-frequency) through the two anchors the 5G simulator uses:
+%   Config.building_penetration_loss_dB at 3.5 GHz (default 20 dB) and
+%   that value + Config.mmwave_extra_penetration_dB at 28 GHz (default 45 dB).
+% The slope (about 28 dB per decade) follows the trend of the TR 38.901
+% high-loss model (26.8 dB at 3.5 GHz, 37.9 dB at 28 GHz, 47.5 dB at 60 GHz).
+% Results: about 28 dB at 7 GHz and 54 dB at 60 GHz with the default anchors.
+    L35 = Config.building_penetration_loss_dB;
+    extra = 25;
+    if isfield(Config, 'mmwave_extra_penetration_dB'), extra = Config.mmwave_extra_penetration_dB; end
+    L28 = L35 + extra;
+    L_dB = L35 + (L28 - L35) * log10(f_GHz / 3.5) / log10(28 / 3.5);
+end
