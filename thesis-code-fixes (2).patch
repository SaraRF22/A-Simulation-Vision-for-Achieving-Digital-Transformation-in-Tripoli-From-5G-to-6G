+function share = allocate_bandwidth_with_gbr(bw_MHz, se, gbr_mbps)
+% Equal share (PF steady state); users short of the GBR are topped up
+% from the users above it, re-checked until nobody else falls below.
+    n = numel(se);
+    share = repmat(bw_MHz / n, n, 1);
+    if gbr_mbps <= 0, return; end
+    ok = se > 0;
+    need = zeros(n, 1);
+    need(ok) = gbr_mbps ./ se(ok);
+    if sum(need(ok)) > bw_MHz
+        % Cell cannot meet every GBR: scale the needs to the available bandwidth.
+        share = zeros(n, 1);
+        share(ok) = need(ok) * bw_MHz / sum(need(ok));
+        return;
+    end
+    fixed = false(n, 1);
+    while true
+        free_MHz = bw_MHz - sum(share(fixed));
+        share(~fixed) = free_MHz / sum(~fixed);
+        short = ~fixed & ok & (share .* se < gbr_mbps);
+        if ~any(short), break; end
+        share(short) = need(short);
+        fixed = fixed | short;
+        if all(fixed)
+            share = share + (bw_MHz - sum(share)) / n;  % hand back any unused bandwidth
+            break;
+        end
+    end
 end
