+function M = compute_imt_metrics(tput_mbps, cell_id, user_bw_Hz, generation, label)
+% COMPUTE_IMT_METRICS  Evaluates simulation output with the ITU-R metric
+% definitions and compares it with the IMT-2020 or IMT-2030 Dense Urban
+% downlink minimum requirements.
+%
+%   tput_mbps  : per-user throughput (Mbit/s)
+%   cell_id    : serving cell (TRxP) index per user, 0 = not served
+%   user_bw_Hz : bandwidth available to each user's serving TRxP (Hz)
+%   generation : 'IMT-2020' (5G) or 'IMT-2030' (6G)
+%
+% Definitions (ITU-R M.2410 / M.2412, kept for IMT-2030):
+%   user experienced data rate = 5th percentile of the user throughput CDF
+%   5th percentile user SE     = 5th percentile of (user throughput / bandwidth)
+%   average SE per TRxP        = sum of user throughput in a TRxP / its bandwidth,
+%                                averaged over TRxPs that serve at least one user
+%   peak data rate             = highest user throughput observed (one layer)
+%
+% Targets (Dense Urban, downlink):
+%   IMT-2020: Report ITU-R M.2410-0
+%   IMT-2030: draft Report ITU-R M.[IMT-2030.TECH PERF REQ] (WP 5D, Feb 2026),
+%             mirrored in 3GPP TR 38.914 (June 2026)
+% The ITU values assume >= 10 full-buffer UEs per TRxP and multi-layer MIMO.
+% This simulator uses 1 UE per sector and one spatial layer, so the comparison
+% shows the gap to the targets; it is not a formal IMT evaluation.
+
+    if nargin < 5, label = generation; end
+    tput_mbps = tput_mbps(:); cell_id = cell_id(:); user_bw_Hz = user_bw_Hz(:);
+
+    switch upper(generation)
+        case 'IMT-2020'
+            T.ue_rate_mbps = 100;  T.se5 = 0.225; T.se_avg = 7.8;  T.peak_gbps = 20;
+        case 'IMT-2030'
+            T.ue_rate_mbps = 300;  T.se5 = 0.675; T.se_avg = 23.4; T.peak_gbps = 36;
+        otherwise
+            error('generation must be IMT-2020 or IMT-2030');
+    end
+
+    user_se = (tput_mbps * 1e6) ./ user_bw_Hz;
+    M.ue_rate_mbps = prctile(tput_mbps, 5);
+    M.se5 = prctile(user_se, 5);
+
+    cells = unique(cell_id(cell_id > 0));
+    se_cell = zeros(numel(cells), 1);
+    for k = 1:numel(cells)
+        in_cell = (cell_id == cells(k));
+        se_cell(k) = sum(tput_mbps(in_cell)) * 1e6 / user_bw_Hz(find(in_cell, 1));
+    end
+    M.se_avg = mean(se_cell);
+    M.peak_gbps = max(tput_mbps) / 1000;
+    M.targets = T;
+
+    verdict = @(ok) char(ok * 'Met    ' + ~ok * 'Not met');
+    fprintf('\n--- %s: %s Dense Urban DL requirements ---\n', label, generation);
+    fprintf('%-34s | %10s | %10s | %s\n', 'Metric', 'Simulated', 'Target', 'Result');
+    fprintf('%-34s | %10.1f | %10.1f | %s\n', 'User experienced rate (Mbit/s)', M.ue_rate_mbps, T.ue_rate_mbps, verdict(M.ue_rate_mbps >= T.ue_rate_mbps));
+    fprintf('%-34s | %10.3f | %10.3f | %s\n', '5th percentile SE (bit/s/Hz)', M.se5, T.se5, verdict(M.se5 >= T.se5));
+    fprintf('%-34s | %10.2f | %10.2f | %s\n', 'Average SE per TRxP (bit/s/Hz)', M.se_avg, T.se_avg, verdict(M.se_avg >= T.se_avg));
+    fprintf('%-34s | %10.2f | %10.2f | %s\n', 'Peak data rate (Gbit/s, 1 layer)', M.peak_gbps, T.peak_gbps, verdict(M.peak_gbps >= T.peak_gbps));
+end
