+function sll = sll_beyond_first_null(pattern_dB, theta)
+    [~, k] = max(pattern_dB);                 % main-lobe peak (broadside)
+    while k < numel(pattern_dB) && pattern_dB(k+1) <= pattern_dB(k), k = k + 1; end
+    sll = max(pattern_dB(abs(theta) > abs(theta(k))));
+end
+
