@@ -76,8 +79,10 @@ function AF = array_factor(weights, pos, theta, target)
 end
 
 function sll = calculate_sll(AF, theta)
-    % Find max side lobe level (exclude main beam region +/- 10 deg)
-    AF_db = 20*log10(abs(AF));
-    mask = abs(theta) > 10;
-    sll = max(AF_db(mask));
+    % Max side lobe level beyond the first null (a fixed +/-10 deg mask cut
+    % into the widened main lobe of the tapered array and mis-measured it).
+    AF_db = 20*log10(abs(AF) + 1e-12);
+    [~, k] = max(AF_db);
+    while k < numel(AF_db) && AF_db(k+1) <= AF_db(k), k = k + 1; end
+    sll = max(AF_db(abs(theta) > abs(theta(k))));
 end
